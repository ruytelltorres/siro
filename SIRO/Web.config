<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>
	<log4net>
		<root>
			<level value="ALL" />
			<appender-ref ref="RollingFileAppender" />
		</root>
		<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
			<file value="C:\Log\siro.log">
			</file>
			<!--This is the location-->
			<appendToFile value="true" />
			<rollingStyle value="Size" />
			<maxSizeRollBackups value="1" />
			<!--This sets the number of times the backup should be taken-->
			<maximumFileSize value="5KB" />
			<!--This is the max size of the log file. After this, the log file gets backed up and a new file is created -->
			<staticLogFileName value="true" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date %5level %logger - %message%newline" />
			</layout>
		</appender>
	</log4net>
	<connectionStrings>
		<add name="ServerConnectDBSiro" connectionString="Data Source=VALERIA;Initial Catalog=DBSiro;User ID=sa;Password=admin@2026;Max Pool Size=4000" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />
		<add key="LDAP" value="LDAP://DC=cmacmaynas,DC=com,DC=pe" />
		<!-- Azure AD application config -->

	<!--
    Para obtener una descripción de los cambios de web.config, vea http://go.microsoft.com/fwlink/?LinkId=235367.

    Los siguientes atributos se pueden establecer en la etiqueta <httpRuntime>.
      <system.Web>
        <httpRuntime targetFramework="4.7.2" />
      </system.Web>
  -->
	<system.web>
		<httpRuntime maxRequestLength="10240" executionTimeout="36000" />
		<compilation debug="true" targetFramework="4.7.2" />
		<authentication mode="Forms">
			<forms loginUrl="~/Login/Login" timeout="30" />
		</authentication>
		<membership defaultProvider="SesionProvider">
			<providers>
				<clear />
				<add name="SesionProvider" type="CMACMaynas.Web.SIRO.Seguridad.SesionProvider, CMACMaynas.Web.SIRO.Seguridad" />
			</providers>
		</membership>
		<roleManager defaultProvider="RolesProvider" enabled="true" cacheRolesInCookie="true">
			<providers>
				<add name="RolesProvider" type="CMACMaynas.Web.SIRO.Seguridad.RolesProvider, CMACMaynas.Web.SIRO.Seguridad" />
			</providers>
		</roleManager>
		<!--<httpRuntime targetFramework="4.6.1" />-->

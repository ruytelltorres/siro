<div class="modal fade custom-width" id="ModalAdmiteCargo">
    <div class="modal-dialog" style="width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h3 class="modal-title"><strong>Criterios Evalución</strong></h3>
            </div>
            <div class="modal-body">
                <form id="form-reg-criterios-eval" method="post" action="" class="validate">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="selRC" class="control-label">Responsable Ejecución(RC)</label>
                                <select id="selRC" class="selectboxit" data-size="8" data-first-option="false"></select>
                            </div>
                            <div class="form-group">
                                <label for="selFD" class="control-label">Periodo de Ejecución(FD)</label>
                                <select id="selFD" class="selectboxit" data-size="8" data-first-option="false"></select>
                            </div>
                            <div class="form-group">
                                <label for="selED" class="control-label">Evidencia del Control(ED)</label>
                                <select id="selED" class="selectboxit" data-size="8" data-first-option="false"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="selTC" class="control-label">Tipo de Ejecución(TC)</label>
                                <select id="selTC" class="selectboxit" data-size="8" data-first-option="false"></select>
                            </div>
                            <div class="form-group">
                                <label for="selCO" class="control-label">Cumple Objetivo(CO)</label>
                                <select id="selCO" class="selectboxit" data-size="8" data-first-option="false"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="tile-stats tile-white">
                                <div class="icon"><i class="entypo-gauge nivel-efectividad"></i></div>
                                <div id="DescEfectividadControl" class="num">&nbsp;</div>
                                <h3>Efectividad del control</h3>
                                <p>Nivel de la efectividad de control</p>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" id="btnCerrar" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnAdmiteCargoOpcion">Grabar</button>
            </div>
        </div>
    </div>
</div>



<script src="@Url.Content("~/Content/Assets/js/bootstrap-treeview.js")"></script>

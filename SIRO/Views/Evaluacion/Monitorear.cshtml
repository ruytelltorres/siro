@using CMACMaynas.Web.SIRO.Negocio
@using SIRO.Utils.Constantes
@{
    ViewBag.Title = "Monitorear Autoevaluación";
    Usuario usuario = (Usuario)Session["Usuario"];
}
<script type="text/javascript">
    var gUsuario = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(usuario));
    var gModelo = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
</script>

<style>
    .InfoTaller h5 {
        text-transform: uppercase;
        font-weight: bold;
        margin-top: 0;
    }
</style>

<div class="row">
    <div class="panel panel-primary panel-table no-border-radius" data-collapsed="0">
        <div class="panel-heading">
            <div class="panel-title">
                <h4>Monitoreo de Autoevaluaci&oacute;n</h4>
                <span>M&oacute;dulo para el monitoreo de las autoevaluaciones asignados a un taller</span>
            </div>
            <div class="panel-options">
                <a href="#" data-rel="collapse" class="btn-panel-filter" role="button" title="Mostrar u ocultar filtros" aria-label="Mostrar u ocultar filtros"><i class="fa fa-filter" aria-hidden="true"></i></a>
                @if (usuario.cRHCargoCod == ConstGeneral.Get.AnalistaRO)
                {
                    <button type="button" id="btnNotificarUser" class="btn btn-primary" tabindex="10" disabled>Finalizar Taller</button>
                }
            </div>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-12">
                    <form class="form-inline" role="form">
                        <div class="form-group" id="search-col-01">
                            <label class="sr-only" for="selTpoEvaluacion">Proceso</label>
                            <div style="min-width: 250px;">
                                <select id="selTpoEvaluacion" class="selectboxit" data-size="8" data-first-option="false" style="width:30%" @(usuario.cRHCargoCod != ConstGeneral.Get.AnalistaRO ? "disabled" : string.Empty)>
                                    <option value="undefined">Seleccione el tipo de evaluaci&oacute;n</option>
                                    @foreach (var tipos in Model.oLstTipoEvaluacion)
                                    {
                                        if (usuario.cRHCargoCod != ConstGeneral.Get.AnalistaRO)
                                        {
                                            <option value="@tipos.nConsValor" @(tipos.nConsValor == (int)TipoEvaluaciones.Procesos ? "selected" : string.Empty)>@tipos.cConsDescripcion</option>
                                        }
                                        else if (usuario.cRHCargoCod == ConstGeneral.Get.AnalistaRO)
                                        {
                                            <option value="@tipos.nConsValor" @(tipos.nConsValor == (int)TipoEvaluaciones.Procesos ? "selected" : string.Empty)>@tipos.cConsDescripcion</option>
                                        }
                                    }
                                </select>
                            </div>

                        </div>

                        <div class="form-group" id="search-col-02">
                            <label class="sr-only" for="selAreas">&Aacute;rea</label>
                            <div style="min-width: 250px;">
                                <select id="selAreas" class="select2" style="width:100%" @(usuario.cRHCargoCod != ConstGeneral.Get.AnalistaRO ? "disabled" : string.Empty)>
                                    <option value="undefined">Seleccione el &aacute;rea</option>
                                    @{
                                        foreach (var areas in @Model.oLstAreas)
                                        {
                                            if (areas.cAreaCod == usuario.oAreas.cAreaCod && usuario.cRHCargoCod != ConstGeneral.Get.AnalistaRO)
                                            {
                                                <option value=@areas.cAreaCod @(usuario.cRHCargoCod != ConstGeneral.Get.AnalistaRO ? "selected" : string.Empty)>@areas.cAreaDescripcion</option>
                                            }
                                            else
                                            {
                                                <option value=@areas.cAreaCod>@areas.cAreaDescripcion</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group" id="search-col-03">
                            <label class="sr-only" for="selTaller">Taller</label>
                            <div style="min-width: 250px;">
                                <select id="selTaller" class="select2" style="width:100%" tabindex="3"></select>
                            </div>
                        </div>

                        @*<div class="col-md-3">
                                <div class="form-group" id="sec-filtro-procesos">
                                    <label class="control-label" for="selProcesos">Proceso</label>
                                    <select id="selProcesos" class="selectboxit" data-size="8" data-first-option="true" style="width:30%"></select>
                                </div>
                            </div>*@

                        @*<div class="col-md-3">
                                <div class="form-group">
                                    <label class="control-label" for="selSubProcesos">Sub Proceso</label>
                                    <select id="selSubProcesos" class="selectboxit" data-size="8" data-first-option="false" style="width:30%"></select>
                                </div>
                            </div>*@

                        @*
                            <div class="col-md-2" id="search-col-04">
                                <br />
                                <button type="button" id="btnMostrar" class="btn btn-primary" style="float:right" tabindex="10">Mostrar</button>
                            </div>*@



                        <button type="button" id="btnProcesar" class="btn btn-primary">
                            <i class="fa fa-refresh" aria-hidden="true"></i>
                            Consultar Datos
                        </button>
                    </form>
                </div>
            </div>
            <br />
            <div class="row InfoTaller" style="display: none">
                <div class="col-sm-2">
                    <h5>C&oacute;digo del taller</h5>
                    <p id="tdCodTaller"></p>
                </div>

                <div class="col-sm-2">
                    <h5>Estado del taller</h5>
                    <p id="tdEstadoTaller"></p>
                </div>

                <div class="col-sm-2">
                    <h5>Usuario notificaci&oacute;n</h5>
                    <p id="tdUserNotifica"></p>
                </div>

                <div class="col-sm-2">
                    <h5>Fecha de creaci&oacute;n</h5>
                    <p id="tdFechaCrea"></p>
                </div>
            </div>


            @*<div class="row">
                    <div class="col-md-12">
                        <div class="col-md-4">
                            <label for="selUsuarios" class="control-label">Usuarios</label>
                            <select id="selUsuarios" class="select2" style="width:100%" tabindex="2"></select>
                        </div>
                        <div class="col-md-3">
                            <label for="selTaller" class="control-label">Taller</label>
                            <select id="selTaller" class="select2" style="width:100%" tabindex="3"></select>
                        </div>
                    </div>
                </div>*@

            @*<div class="row">
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <div class="panel-title">
                                Evaluaciones
                            </div>
                        </div>
                        <div class="panel-body">

                        </div>
                    </div>
                </div>*@

        </div>

        <div id="content-tbl-evaluaciones-monitoreo"></div>
    </div>


</div>


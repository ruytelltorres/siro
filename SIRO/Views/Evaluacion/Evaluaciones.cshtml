@using CMACMaynas.Web.SIRO.Negocio
@using SIRO.Utils.Constantes
@{
    ViewBag.Title = "Monitorear Evaluación";
    Usuario usuario = (Usuario)Session["Usuario"];
}
<script type="text/javascript">
    var gUsuario = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(usuario));
    var gModelo = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
</script>

<div class="row">
    <div class="col-md-12">
        <!--Añadir shadow-panel , para agregar afecto de sobra al modulo-->
        <div class="panel panel-primary panel-table">
            <div class="panel-heading">
                <div class="panel-title">
                    <h3>Monitorear Autoevaluaci&oacute;n</h3>
                    <span>M&oacute;dulo para el monitoreo de las autoevaluaciones asignados a un taller</span>
                </div>
            </div>
            <div class="panel-body" style="background:#fff">
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-4">
                            <label for="selUsuarios" class="control-label">Usuarios</label>
                            <select id="selUsuarios" class="select2" style="width:100%" tabindex="2"></select>
                        </div>
                        <div class="col-md-3">
                            <label for="selTaller" class="control-label">Taller</label>
                            <select id="selTaller" class="select2" style="width:100%" tabindex="3"></select>
                        </div>
                    </div>
                </div>

                @*<div class="row">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="panel-title">
                                    Evaluaciones
                                </div>
                            </div>
                            <div class="panel-body">

                            </div>
                        </div>
                    </div>*@

                <div class="col-md-12" style="padding-top: 10px">
                    <div id="content-tbl-evaluaciones-monitoreo"></div>
                </div>

                <div class="row">
                    <div class="col-md-12" style="padding-top: 5px">
                        <div class="col-md-12" id="pnlDetTaller">
                            <div class="panel-group joined" id="accordion-test-2">
                                <div class="panel panel-default">
                                    <div class="panel-heading">
                                        <h4 class="panel-title" style="padding: 5px 10px">
                                            <a data-toggle="collapse" data-parent="#accordion-test-2" href="#collapseTwo-2" class="collapsed">Detalle del Taller</a>
                                        </h4>
                                    </div>
                                    <div id="collapseTwo-2" class="panel-collapse collapse">
                                        <div class="panel-body">
                                            <table class="table-bordered" style="width: 100%">
                                                <tbody>
                                                    <tr>
                                                        <td class="col-lg-3 trTitulo"><strong>Código Taller</strong></td>
                                                        <td class="col-lg-3 trValor" id="tdCodTaller"></td>
                                                    </tr>
                                                    <tr>
                                                        <td class="col-lg-3 trTitulo"><strong>Estado del Taller</strong></td>
                                                        <td class="col-lg-3 trValor" id="tdEstadoTaller"></td>
                                                    </tr>
                                                    <tr>
                                                        <td class="col-lg-3 trTitulo"><strong>F. Creaci&oacute;n</strong></td>
                                                        <td class="col-lg-3 trValor" id="tdFechaCrea"></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            @if (usuario.cRHCargoCod == ConstGeneral.Get.AnalistaRO)
            {
                <div class="panel-footer" style="padding:30px">
                    <div class="row">
                        <div class="col-md-6 pull-left">
                            <button type="button" id="btnNotificarUser" name="btnNotificarUser" class="btn btn-primary" tabindex="10" disabled>Finalizar Taller</button>
                        </div>
                        <div class="col-md-6 pull-right">
                            @*<button type="button" id="btnRegEvaluacion" name="btnRegEvaluacion" class="btn btn-primary" tabindex="9">Guardar</button>
                                <button type="button" id="btnCancelar" name="btnCancelar" class="btn btn-primary" tabindex="8">Cancelar</button>*@
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

</div>


@*@model SIRO.ViewModel.LoginViewModel*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SIRO" />
    <meta name="author" content=Ruytell Torres Rengifo" />

    <link rel="icon" href="@Url.Content("~/Content/assets/images/default/favicon.ico")">

    <title>Inicio de sesi&oacute;n</title>

    <link rel="stylesheet" href="@Url.Content("~/Content/assets/js/jquery-ui/css/no-theme/jquery-ui-1.10.3.custom.min.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/font-icons/entypo/css/entypo.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/bootstrap.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/neon-core.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/neon-theme.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/neon-forms.css")">
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/custom.css")">
    @*<link rel="stylesheet" href="@Url.Content("~/Content/assets/css/skins/red.css")">*@
    <link rel="stylesheet" href="@Url.Content("~/Content/assets/css/skins/white.css")">

    <script src="~/Content/assets/js/jquery-1.11.3.min.js"></script>

</head>
<body class="page-body login-page login-form-fall" data-url="http://www.cajamaynas.pe/">

    <div class="login-container">
        <div class="login-header login-caret">
            <div class="login-content">
                <a href="#" class="logo">
                    <img src="@Url.Content("~/Content/Assets/images/default/logo-siro.png")" width="250" alt="Logo Caja Maynas" />
                </a>
                @*<p class="description">Sistema de Informaci&oacute;n de Riesgo Operacional</p>*@

                <div class="login-progressbar-indicator">
                    <h3>43%</h3>
                    <span>Iniciando sesión...</span>
                </div>
            </div>

        </div>

        <div class="login-progressbar">
            <div></div>
        </div>


        <div class="login-form">
            <div class="login-content">
                <div class="form-login-error">
                    <h3></h3>
                    @*<p>Enter <strong>demo</strong>/<strong>demo</strong> as login and password.</p>*@
                </div>

                <form method="post" role="form" id="form_login">
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="entypo-user"></i>
                            </div>
                            <div class="col-md-12 col-sm-12">
                                <input type="text" class="form-control" name="inUsuario" id="inUsuario" placeholder="Usuario" autocomplete="off" maxlength="4" autofocus="" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-addon">
                                <i class="entypo-key"></i>
                            </div>
                            <div class="col-md-12 col-sm-12">
                                <input type="password" class="form-control" name="inClave" id="inClave" placeholder="Contraseña" autocomplete="off" maxlength="20" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary btn-block btn-login">
                            <i class="entypo-login"></i>
                            Iniciar sesión
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Content/assets/js/gsap/TweenMax.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/jquery-ui/js/jquery-ui-1.10.3.minimal.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/bootstrap.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/joinable.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/resizeable.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/neon-api.js")"></script>

    @* Descomentar al cambiar el metodo de validacion *@
    <script src="@Url.Content("~/Content/assets/js/conexion.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/neon-login.js")"></script>
    @* end *@


    <script src="@Url.Content("~/Content/assets/js/neon-custom.js")"></script>
    <script src="@Url.Content("~/Content/assets/js/neon-demo.js")"></script>
</body>
</html>

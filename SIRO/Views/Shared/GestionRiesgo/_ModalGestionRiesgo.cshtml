
<div class="modal fade custom-width" id="AddCriteriosEval" data-backdrop="static">
    <div class="modal-dialog" style="width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>*@
                <h3 class="modal-title"><strong>Control de la Evalución</strong></h3>
            </div>
            <div class="modal-body">
                @*<form id="form-reg-criterios-eval" method="post" action="" class="validate">*@
                    <div class="row">
                        <div class="col-md-12 col-sm-12">
                            <div class="form-group">
                                <label for="inDescControl" class="control-label">Descripción del Control</label>
                                <textarea class="form-control" id="inDescControl" name="inDescControl" data-validate="minlength[10]" rows="5" placeholder="Describa el motivo de aplicar el control"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="tile-stats tile-white">
                                <div class="icon"><i class="entypo-gauge nivel-efectividad"></i></div>
                                <h3 id="DescEfectividadControl">Eficacia del control</h3>
                                <p>Nivel de la efectividad de control calculado según selección de los creiterios de evaluación</p>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="selRC" class="control-label">Responsable Ejecución(RC)</label>
                                <select id="selRC" class="selectboxit" data-first-option="false"></select>
                            </div>
                            <div class="form-group">
                                <label for="selTC" class="control-label">Tipo de Ejecución(TC)</label>
                                <select id="selTC" class="selectboxit" data-first-option="false"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="selFD" class="control-label">Periodo de Ejecución(FD)</label>
                                <select id="selFD" class="selectboxit" data-first-option="false"></select>
                            </div>

                            <div class="form-group">
                                <label for="selCO" class="control-label">Cumple Objetivo(CO)</label>
                                <select id="selCO" class="selectboxit" data-first-option="false"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="selED" class="control-label">Evidencia del Control(EC)</label>
                                <select id="selED" class="selectboxit" data-first-option="false"></select>
                            </div>
                        </div>
                    </div>
                @*</form>*@
            </div>
            <div class="modal-footer">
                <div class="pull-left">
                    <button type="button" class="btn btn-default" id="btnCerrarAddControlRiesgoResidual" data-dismiss="modal">Cerrar</button>
                </div>
                <div class="pull-right">
                    <button type="button" class="btn btn-primary" id="btnAddControlRiesgoResidual">Grabar</button>
                    <button type="button" class="btn btn-primary" id="btnUpdControlRiesgoResidual">Grabar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade custom-width" id="AddPlanesAccion" data-backdrop="static">
    <div class="modal-dialog" style="width: 60%">
        <div class="modal-content">
            <div class="modal-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>*@
                <h3 class="modal-title"><strong>Planes de Acción</strong> <strong id="cod-plan-accion"></strong></h3>
            </div>
            <div class="modal-body">
                <div class="cod-plan" data-cod-plan=""></div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="control-label" for="inDescPlanAccion">Plan de acción</label>
                            <textarea class="form-control" name="inDescPlanAccion" id="inDescPlanAccion" rows="5" placeholder="Descripción del plan del acción" value="suma"></textarea>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="control-label" for="inFechaImplementacion">Fecha de Implementación</label>
                            <input class="form-control" name="inFechaImplementacion" id="inFechaImplementacion" data-mask="date" placeholder="Fecha Implementación" />

                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="form-group">
                            <label class="control-label">¿Control Sugerido?</label> <small>(Marcar s&iacute;, si el control fue sugerido por la gerencia mancomunada)</small>
                            <br />
                            <div class="make-switch switch-default" data-on-label="Si" data-off-label="No">
                                    <input type="checkbox" id="chkSugeridoGM" >
                            </div>

                            @*<label for="chkSugeridoGM" class="control-label"> Sugerido por la Gerencia Mancomunada</label>
                            <br />
                            <div class="make-switch switch-small sugerencia" data-on="danger" data-off="default" data-on-label="Si" data-off-label="No">
                                <input id="chkSugeridoGM" name="chkSugeridoGM" type="checkbox" checked>
                            </div>*@
                        </div>
                    </div>
                </div>
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <div class="panel-title">
                            (Opcional) Adjuntar Documentos
                        </div>
                        <div class="panel-options">
                            <a href="#" id="btnAddFile"><i class="fa fa-upload"></i></a>
                        </div>
                    </div>
                    <div id="FileAttach"></div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="control-label" for="inComentPlanAcccion">Comentarios sobre el plan de acción</label>
                            <textarea class="form-control" name="inComentPlanAcccion" id="inComentPlanAcccion" rows="5" placeholder="(Opcional) Comentarios adicionales sobre el plan de acción"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <div class="pull-left">
                    <button type="button" class="btn btn-default" id="btnCerrarAddPlanAccion" data-dismiss="modal">Cerrar</button>
                </div>
                <div class="pull-right">
                    <button type="button" class="btn btn-primary btn-icon" id="btnAddPlanAccion">Grabar <i class="entypo-floppy"></i></button>
                    <button type="button" class="btn btn-primary btn-icon" id="btnUpdPlanAccion">Grabar <i class="entypo-floppy"></i></button>
                </div>
            </div>

        </div>
    </div>
</div>


<div class="modal fade custom-width" id="DetResponsablesPlanesAccion" data-backdrop="static">
    <div class="modal-dialog" style="width: 60%;">
        <div class="modal-content">
            <div class="modal-header">
                <h4><strong>Responsables de Planes de Acción</strong></h4>
            </div>
            <div class="modal-body" style="padding:0px 1.5px 0px 1.5px">
                <div id="tbl-add-responsables-planes-accion"></div>
            </div>
            <div class="modal-footer" style="margin-top:0">
                <div class="pull-left">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>


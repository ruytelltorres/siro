                        <td width="15%" align="center"><strong>Moderado</strong><br /><span>(2.00 %)</span></td>
                        <td width="15%" align="center"><strong>Mayor</strong><br /><span>(4.00 %)</span></td>
                        <td width="15%" align="center"><strong>Catastrófico</strong><br /><span>(6.00 %)</span></td>
                    </tr>
                    <tr>
                        <td align="center" rowspan="5" class="rotate-text"><strong>Probabilidad</strong></td>
                        <td align="center" width="10%" style="background-color:white"><strong>Casi certeza</strong></td>
                        <td class="mapa-calor-moderado" align="center"><a id="lnk-cel-11" href="javascript:MostrarDatosRiesgo(1, 1)"></a></td>
                        <td class="mapa-calor-alto" align="center"><a id="lnk-cel-12" href="javascript:MostrarDatosRiesgo(1, 2)"></a></td>
                        <td class="mapa-calor-extremo" align="center"><a id="lnk-cel-13" style="color:white;" href="javascript:MostrarDatosRiesgo(1, 3)"></a></td>
                        <td class="mapa-calor-extremo" align="center"><a id="lnk-cel-14" style="color:white;" href="javascript:MostrarDatosRiesgo(1, 4)"></a></td>
                        <td class="mapa-calor-extremo" align="center"><a id="lnk-cel-15" style="color:white;" href="javascript:MostrarDatosRiesgo(1, 5)"></a></td>
                    </tr>
                    <tr>
                        <td align="center"><strong>Probable</strong></td>
                        <td id="tbl-cel-2" class="mapa-calor-moderado" align="center"><a id="lnk-cel-21" href="javascript:MostrarDatosRiesgo(2, 1)"></a></td>
                        <td id="tbl-cel-7" class="mapa-calor-alto" align="center"><a id="lnk-cel-22" href="javascript:MostrarDatosRiesgo(2, 2)"></a></td>
                        <td id="tbl-cel-12" class="mapa-calor-alto" align="center"><a id="lnk-cel-23" href="javascript:MostrarDatosRiesgo(2, 3)"></a></td>

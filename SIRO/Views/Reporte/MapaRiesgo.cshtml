@using CMACMaynas.Web.SIRO.Negocio
@{
    ViewBag.Title = "Reportes - Mapa de Riesgo";
    Usuario usuario = (Usuario)Session["Usuario"];
}

<script type="text/javascript">
    var gUsuario = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(usuario));
</script>
<style>
    .alert {
        padding: 10px;
        margin-bottom: 10px;
        border: 1px solid #ebebeb;
        border-radius: 5px;
    }
</style>

<div class="row">
    <div class="panel panel-primary panel-table no-border-radius" data-collapsed="0">
        <div class="panel-heading">
            <div class="panel-title">
                <h4>Mapa de calor de los riesgos</h4>
                <span>M&oacute;dulo para la generaci&oacute;n de mapas de calos para los riesgos operacionales o autoevaluaciones</span>
            </div>
            <div class="panel-options">
                <a href="#" data-rel="collapse" class="btn-panel-filter" role="button" title="Mostrar u ocultar filtros" aria-label="Mostrar u ocultar filtros"><i class="fa fa-filter" aria-hidden="true"></i></a>
                @*<a href="javascript:CargarDatosTabla()"><i class="entypo-arrows-ccw"></i></a>*@
            </div>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="control-label">Tipo de riesgo</label>
                    <select id="selTpoRiesgo" class="selectboxit" data-first-option="false">
                        <option>Seleccione una opci&oacute;n</option>
                        <option value="1" selected>Riesgo Operacional</option>
                        <option value="2">Autoevaluaciones</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="control-label">Nivel del riesgo</label>
                    <select id="selNivelRiesgo" class="selectboxit" data-first-option="false">
                        <option>Seleccione una opci&oacute;n</option>
                        <option value="1" selected>Inherente</option>
                        <option value="2">Residual</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label>&nbsp;</label>
                    <br />
                    <div class="btn-group left-dropdown">
                        <button type="button" class="btn btn-primary">Acciones</button>
                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu pull-right" role="menu">
                            <li>
                                <a href="javascript:GenerarMapaCalorRiesgo()"><i class="fa fa-cubes"></i> Generar Mapa</a>
                            </li>
                            <li class="divider"></li>
                            <li>
                                <a href="javascript:ExportarExcelRiesgosMapaCalor()"><i class="fa fa-file-excel-o"></i> Exportar Excel</a>
                            </li>
                            <li class="divider"></li>
                            <li>
                                <a href="javascript:ExportarTabla('#tbl-mapa-riesgo')"><i class="fa fa-file-image-o"></i> Exportar PNG</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-3">
                <a href="#" onclick="ExportarRiesgosNivelRiesgo(1)">
                    <div class="tile-stats mapa-calor-bajo">
                        <div class="icon"><i class="entypo-gauge"></i></div>
                        <div class="num" id="TotNivRiesgoBajo">0</div>
                        <h3>Riesgo Bajo</h3>

                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="#" onclick="ExportarRiesgosNivelRiesgo(2)">
                    <div class="tile-stats mapa-calor-moderado">
                        <div class="icon"><i class="entypo-gauge"></i></div>
                        <div class="num" id="TotNivRiesgoModerado">0</div>
                        <h3>Riesgo Moderado</h3>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="#" onclick="ExportarRiesgosNivelRiesgo(3)">
                    <div class="tile-stats mapa-calor-alto">
                        <div class="icon"><i class="entypo-gauge"></i></div>
                        <div class="num" id="TotNivRiesgoAlto">0</div>
                        <h3>Riesgo Alto</h3>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="#" onclick="ExportarRiesgosNivelRiesgo(4)">
                    <div class="tile-stats mapa-calor-extremo">
                        <div class="icon"><i class="entypo-gauge"></i></div>
                        <div class="num" id="TotNivRiesgoExtremo">0</div>
                        <h3>Riesgo Extremo</h3>
                    </div>
                </a>
            </div>

            <div class="col-md-12">

                    </tr>
                    <tr>
                        <td align="center"><strong>Moderado</strong></td>
                        <td id="tbl-cel-3" class="mapa-calor-bajo" align="center"><a id="lnk-cel-31" style="color:white;" href="javascript:MostrarDatosRiesgo(3, 1)"></a></td>
                        <td id="tbl-cel-8" class="mapa-calor-moderado" align="center"><a id="lnk-cel-32" href="javascript:MostrarDatosRiesgo(3, 1)"></a></td>
                        <td id="tbl-cel-13" class="mapa-calor-alto" align="center"><a id="lnk-cel-33" href="javascript:MostrarDatosRiesgo(3, 3)"></a></td>
                        <td id="tbl-cel-18" class="mapa-calor-extremo" align="center"><a id="lnk-cel-34" style="color:white;" href="javascript:MostrarDatosRiesgo(3, 4)"></a></td>
                        <td id="tbl-cel-23" class="mapa-calor-extremo" align="center"><a id="lnk-cel-35" style="color:white;" href="javascript:MostrarDatosRiesgo(3, 5)"></a></td>
                    </tr>
                    <tr>
                        <td align="center"><strong>Improbable</strong></td>
                        <td id="tbl-cel-4" class="mapa-calor-bajo" align="center"><a id="lnk-cel-41" style="color:white;" href="javascript:MostrarDatosRiesgo(4, 1)"></a></td>
                        <td id="tbl-cel-9" class="mapa-calor-bajo" align="center"><a id="lnk-cel-42" style="color:white;" href="javascript:MostrarDatosRiesgo(4, 2)"></a></td>
                        <td id="tbl-cel-14" class="mapa-calor-moderado" align="center"><a id="lnk-cel-43" href="javascript:MostrarDatosRiesgo(4, 3)"></a></td>
                        <td id="tbl-cel-19" class="mapa-calor-alto" align="center"><a id="lnk-cel-44" href="javascript:MostrarDatosRiesgo(4, 4)"></a></td>
                        <td id="tbl-cel-24" class="mapa-calor-extremo" align="center"><a id="lnk-cel-45" style="color:white;" href="javascript:MostrarDatosRiesgo(4, 5)"></a></td>
                    </tr>
                    <tr>
                        <td align="center"><strong>Raro</strong></td>
                        <td id="tbl-cel-5" class="mapa-calor-bajo" align="center"><a id="lnk-cel-51" style="color:white;" href="javascript:MostrarDatosRiesgo(5, 1)"></a></td>
                        <td id="tbl-cel-10" class="mapa-calor-bajo" align="center"><a id="lnk-cel-52" style="color:white;" href="javascript:MostrarDatosRiesgo(5, 2)"></a></td>
                        <td id="tbl-cel-15" class="mapa-calor-moderado" align="center"><a id="lnk-cel-53" href="javascript:MostrarDatosRiesgo(5, 3)"></a></td>
                        <td id="tbl-cel-20" class="mapa-calor-alto" align="center"><a id="lnk-cel-54" href="javascript:MostrarDatosRiesgo(5, 4)"></a></td>
                        <td id="tbl-cel-25" class="mapa-calor-alto" align="center"><a id="lnk-cel-55" href="javascript:MostrarDatosRiesgo(5, 5)"></a></td>
                    </tr>
                </table>
                <table class="table table-bordered">
                    <thead>
                        <tr><th>Nivele de Riesgo</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <ul class="list-inline links-list">
                                    <li>
                                        <div class="label label-default mapa-calor-bajo" style="width:20px; height:18px">&nbsp;</div>
                                        <span>Bajo</span>
                                    </li>
                                    <li class="sep"></li>
                                    <li>
                                        <div class="label label-default mapa-calor-moderado" style="width:20px; height:18px">&nbsp;</div>
                                        <span>Moderado</span>
                                    </li>
                                    <li class="sep"></li>
                                    <li>
                                        <div class="label label-default mapa-calor-alto" style="width:20px; height:18px">&nbsp;</div>
                                        <span>Alto</span>
                                    </li>
                                    <li class="sep"></li>
                                    <li>
                                        <div class="label label-default mapa-calor-extremo" style="width:20px; height:18px">&nbsp;</div>
                                        <span>Extremo</span>

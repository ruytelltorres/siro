        @*<div class="panel-footer" style="padding-left:30px; padding-right:30px;">
            <div class="row">
                <div class="col-md-12">
                    <div class="pull-left">

                    </div>
                    <div class="pull-right">
                        <button id="btnRegRiesgoOpe" type="button" class="btn btn-primary btn-block btn-icon">Guardar<i class="entypo-floppy"></i></button>

                    </div>
                </div>
            </div>
        </div>*@
    </div>
</div>




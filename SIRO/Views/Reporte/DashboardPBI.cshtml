
@{
    ViewBag.Title = "Informe Evento Pérdida";
}
<script type="text/javascript">
    var gToken = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.TOKEN));
    @*var gToken = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));*@


@{
    ViewBag.Title = "Grupo Eventos";
}
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary panel-table">
            <div class="panel-heading">
                <div class="panel-title">
                    <h3>Grupo de Eventos: <strong>@Model.oEventoPerdida.oDatosRiesgo.cCodRiesgo</strong></h3>
                    <span>Gesti&oacute;n de los eventos de perdida asignados al grupo</span>
                </div>
            </div>
            <div class="panel-body" style="background:#fff">
                <div class="row col-md-12">

                </div>
                <div class="row col-md-12">
                    <table id="tbl-grupo-evento" class="table table-hover">
                        <thead>
                            <tr>
                                <td class="text-center text-primary" width="3%"><strong>Item</strong></td>
                                <td class="text-center text-primary" width="15%"><strong>Descripci&oacute;n</strong></td>
                                <td class="text-center text-primary" width="8%"><strong>Monto Bruto</strong></td>
                                <td class="text-center text-primary" width="8%"><strong>P&eacute;rdida Neta</strong></td>
                                <td class="text-center text-primary" width="5%"><strong>Usuario</strong></td>
                                <td class="text-center text-primary" width="8%"><strong>Fecha Reg.</strong></td>
                                <td class="text-center text-primary" width="5%"><strong>Acciones</strong></td>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.oLstEventoGrupo != null)
                            {
                                foreach (var item in Model.oLstEventoGrupo)
                                {
                                    <tr>
                                        <td><p class="text-primary text-center">@Convert.ToInt32(item.oDatosRiesgo.cCodRiesgo)</p></td>
                                        <td><div class="scrollable"><p class="text-primary">@item.oDatosRiesgo.cRiesgoIdentiticado</p></div></td>
                                        <td><p class="text-primary text-center">@String.Format("{0:n}", item.nMontoBruto)</p></td>
                                        <td><p class="text-primary text-center">@String.Format("{0:n}", item.nPerdidaNeta)</p></td>
                                        <td><p class="text-primary text-center">@item.cUserRegistra</p></td>
                                        <td><p class="text-primary text-center">@item.dFechaRegistro</p></td>
                                        <td>
                                            <button type="button" class="btn btn-default btn-xs" title="Editar" onclick="VerEventoGrupo(@item.oDatosRiesgo.nNroRiesgo)"><i class="entypo-eye"></i></button>
                                            <button type="button" class="btn btn-success btn-xs" title="Editar" onclick="EditarEventoGrupo(@item.oDatosRiesgo.nNroRiesgo)"><i class="entypo-pencil"></i></button>
                                            <button type="button" class="btn btn-danger btn-xs" title="Eliminar" onclick="EliminaEventoGrupo(@item.oDatosRiesgo.nNroRiesgo)"><i class="entypo-cancel"></i></button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7"><p class="text-danger">El evento de p&eacute;rdida no cuenta elementos en su grupo</p></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel-footer">
                <div class="row">
                    <div class="col-md-12">
                        <div class="pull-left">
                            <button type="button" class="btn btn-primary" id="btnEventosAgrupados">Exportar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $("#btnEventosAgrupados").click(function (e) {
        e.preventDefault();
        var param = { evento: base64_encode(@Model.oEventoPerdida.oDatosRiesgo.nNroRiesgo) };
        debugger;
        $.fn.Conexion({
            direccion: "/RiesgoOperacional/DevolverVistaParam",
            datos: { Vista: "ReporteEventosAgrupados", Controlador: "EventoPerdida", Parametros: JSON.stringify(param) },
            terminado: function (data) {
                window.location = data.url;
            },
        });
    });

    function VerEventoGrupo() {
        var param = { evento: base64_encode(codevento) };
        $.fn.Conexion({
            direccion: "/RiesgoOperacional/DevolverVistaParam",
            datos: { Vista: "Detalle", Controlador: "EventoPerdida", Parametros: JSON.stringify(param) },
            terminado: function (data) {
                window.location = data.url;
            },
        });
    }

    function EditarEventoGrupo(codevento) {
        var param = { evento: base64_encode(codevento) };
        $.fn.Conexion({
            direccion: "/RiesgoOperacional/DevolverVistaParam",
            datos: { Vista: "Modificar", Controlador: "EventoPerdida", Parametros: JSON.stringify(param) },
            terminado: function (data) {
                window.location = data.url;
            },
        });
    }

    function EliminaEventoGrupo(codevento) {
        var param = { evento: base64_encode(codevento) };
        $.fn.Conexion({
            direccion: "/EventoPerdida/EliminarEventoGrupo",
            datos: { psCodEvento: "" },
            terminado: function (data) {


                
            },
        });
    }
</script>

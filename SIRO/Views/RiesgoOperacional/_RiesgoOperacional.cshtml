
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label for="inRiesgoIdentificado" class="control-label">Riesgo identificado</label>
            <textarea class="form-control scrolltextarea" id="inRiesgoIdentificado" data-validate="minlength[10]" rows="5" placeholder="Descripción del riesgo identificado" style="width:100%" tabindex="1">@if (Model.oRiesgoOperacional != null) { @Model.oRiesgoOperacional.cRiesgoIdentiticado}</textarea>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label for="selAgencias" class="control-label">Agencia afectada</label>
            <select id="selAgencias" class="select2" data-allow-clear="true" style="width:100%" tabindex="2">
                <option></option>
                <optgroup label="Lista de Agencias">
                    @{
                        foreach (var agencias in Model.oLstAgencia)
                        {
                            if (Model.oRiesgoOperacional != null)
                            {
                                if (Model.oRiesgoOperacional.oAgencia.cAgeCod == agencias.cAgeCod)
                                {
                                    <option value=@agencias.cAgeCod selected> @agencias.cAgeDescripcion</option>
                                }
                                else
                                {
                                    <option value=@agencias.cAgeCod> @agencias.cAgeDescripcion</option>
                                }
                            }
                            else
                            {
                                <option value=@agencias.cAgeCod>@agencias.cAgeDescripcion</option>
                            }
                        }
                    }
                </optgroup>
            </select>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label for="selAreas" class="control-label">Áreas afectada</label>
            <select id="selAreas" class="select2" data-allow-clear="true" style="width:100%" tabindex="3">
                <option></option>
                <optgroup label="Listas de Áreas">
                    @{
                        foreach (var areas in @Model.oLstAreas)
                        {
                            if (Model.oRiesgoOperacional != null)
                            {
                                if (Model.oRiesgoOperacional.oAgencia.oArea.cAreaCod == areas.cAreaCod)
                                {
                                    <option value=@areas.cAreaCod selected> @areas.cAreaDescripcion</option>
                                }
                                else
                                {
                                    <option value=@areas.cAreaCod> @areas.cAreaDescripcion</option>
                                }
                            }
                            else
                            {
                                <option value=@areas.cAreaCod>@areas.cAreaDescripcion</option>
                            }
                        }
                    }
                </optgroup>
            </select>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label for="selCausaRiesgo" class="control-label">Causas</label>
            <select id="selCausaRiesgo" class="select2" multiple="multiple" style="width:100%" data-placeholder="Seleccione la(s) causa(s) del riesgo" tabindex="7">
                @{
                    //string[] lsCausas = Model.oRiesgoOperacional != null ? Convert.ToString(Model.oRiesgoOperacional.oCausas.cCodCausa).Split('|') : null;
                    string lsCausas = Model.oRiesgoOperacional != null ? Convert.ToString(Model.oRiesgoOperacional.oCausas.cCodCausa).Replace(" ", "") : null;

                    if (Model.oRiesgoOperacional != null)
                    {
                        foreach (var causas in Model.oLstCausas)
                        {
                            if (lsCausas.Contains(causas.cCodCausa))
                            {
                                <option value=@causas.cCodCausa selected>@causas.cCausaDesc</option>
                            }
                            else
                            {
                                <option value=@causas.cCodCausa>@causas.cCausaDesc</option>
                            }
                        }
                    }
                    else
                    {
                        foreach (var causas in Model.oLstCausas)
                        {
                            <option value=@causas.cCodCausa>@causas.cCausaDesc</option>
                        }
                    }
                }
            </select>
        </div>
    </div>
</div>


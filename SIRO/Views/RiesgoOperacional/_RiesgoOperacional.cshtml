    <div class="col-md-3">
        <div class="form-group">
            <label for="inFechaDeteccion" class="control-label">Fecha de detecci&oacute;n</label>
            <input class="form-control" name="inFechaDeteccion" id="inFechaDeteccion" data-mask="date" placeholder="Fecha" tabindex="8" value="@if (Model.oRiesgoOperacional != null) { @Model.oRiesgoOperacional.dFechaDeteccion}" />
        </div>
    </div>

    <div class="col-md-2">
        <div class="form-group">
            <label for="chkEfectividadControl" class="control-label">¿Control efectivo?</label>
            <br />
            <div class="make-switch switch-default check-control-efectivo" data-on-label="Si" data-off-label="No">
                @if (Model.oRiesgoOperacional != null)
                {
                    <input type="checkbox" id="chkEfectividadControl" @(Model.oRiesgoOperacional.bControlEfectivo ? "checked=true" : string.Empty)>
                }
                else
                {
                    <input type="checkbox" id="chkEfectividadControl">
                }
            </div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <div class="panel-title bold">
                    <h4>Definici&oacute;n de controles</h4>
                    <span>Agrega los controles identificados para el riesgo operacional reportado</span>
                </div>
                <div class="panel-options">
                    <button type="button" class="btn btn-primary" onclick="AgregarControl()">Agregar control</button>
                    @*<a href="javascript:eliminarFila()"><i class="entypo-trash"></i></a>*@
                </div>
            </div>

            <table id="tbl-controles-riesgo" class="table table-bordered">
                <thead>
                    <tr>
                        <td class="text-center bold text-primary" width="60%">Descripci&oacute;n del control</td>
                        <td class="text-center bold text-primary" width="5%">Acci&oacute;n</td>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.oRiesgoOperacional != null)
                    {
                        if (Model.oLstRiesgoResidual != null)
                        {
                            int nItemControl = 0;
                            foreach (var controles in Model.oLstRiesgoResidual)
                            {
                                nItemControl++;
                                string cID_Control = "ctrl" + Convert.ToString(nItemControl);
                                <tr id="@cID_Control">
                                    <td class="text-justify">@controles.cComentario</td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                                <i class="entypo-dot-3"></i><span class="sr-only">Toggle Dropdown</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-default pull-right">
                                                <li>
                                                    <a href="javascript:EliminarControl(@nItemControl)">
                                                        <i class="entypo-trash"></i>
                                                        Eliminar
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


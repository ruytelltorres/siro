<div class="row">
    <div class="col-md-12">
        <div class="form-group">
            <label for="inObservacion" class="control-label">Efectos del riesgo identificado</label>
            <textarea class="form-control scrolltextarea" id="inObservacion" name="inObservacion" data-validate="minlength[10]" rows="5" placeholder="(Opcional) Indicar en que consiste y afecta el riesgo" style="width:100%;" tabindex="9">@if (Model.oRiesgoOperacional != null) { @Model.oRiesgoOperacional.cEfectosRiesgo}</textarea>
        </div>
    </div>
</div>



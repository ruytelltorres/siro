      <mvcSiteMapNode title="Matriz de Evento de Pérdida" controller="Reporte" action="MatrizEventoPerdida" />
      <mvcSiteMapNode title="Mapa de Riesgo" controller="Reporte" action="MapaRiesgo" />
      <mvcSiteMapNode title="Reportes Gráficos" controller="Reporte" action="Grafico" />
      <mvcSiteMapNode title="Reportes Varios" controller="Reporte" action="Varios" />
      <mvcSiteMapNode title="Dashboard PBI" controller="Reporte" action="DashboardPBI" />

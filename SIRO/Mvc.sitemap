      <mvcSiteMapNode title="Monitorear Evaluaciones" controller="Evaluacion" action="Monitorear" />
      <mvcSiteMapNode title="Gestión de Evaluaciones" controller="Evaluacion" action="Evaluaciones" />
    </mvcSiteMapNode>

    <mvcSiteMapNode title="Evento de Pérdida" controller="EventoPerdida" action="Lista">
      <mvcSiteMapNode title="Registrar Evento de Pérdida" controller="EventoPerdida" action="Registrar" />
      <mvcSiteMapNode title="Lista de Eventos de Pérdida" controller="EventoPerdida" action="Lista" />

      <mvcSiteMapNode title="Gestionar Riesgo Operacional" controller="RiesgoOperacional" action="GestionRiesgo" />
      <mvcSiteMapNode title="Planes de Acción" controller="RiesgoOperacional" action="PlanesAccion" />
      <mvcSiteMapNode title="Comentario de Plan de Acción" controller="RiesgoOperacional" action="ComentarioPlanAccion" />
      <mvcSiteMapNode title="Gestión de Incentivos" controller="RiesgoOperacional" action="GestionIncentivo" />
